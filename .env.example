# =============================================================
#  DingDong LMS — 로컬 개발용 환경변수 예시
# -------------------------------------------------------------
#  사용법:
#    1) 이 파일을 .env 로 복사한다.   cp .env.example .env
#    2) 본인의 키 값을 채운다.
#    3) .env 는 .gitignore 로 제외되어 커밋되지 않는다.
#
#  ⚠️ 이 파일에는 실제 키를 절대 넣지 말 것. 예시/빈 값만 유지한다.
#
#  ── 이건 "오버라이드"일 뿐이다 ────────────────────────────────
#  DingDong LMS 는 zip 배포 → 설치 사이트 관리자가 화면에서 본인 키를
#  등록하는 것이 정상 경로다(AGENTS.md 규칙 8). 여기 값을 비워 두면
#  기존처럼 wp_options 에 저장된 키를 사용한다. 값을 채우면 그 값이 우선한다.
#
#  해석 우선순위:  PHP 상수  →  환경변수(.env)  →  wp_options
#
#  ⚠️ WordPress Studio 는 Playground(PHP-WASM)에서 동작하므로 getenv() 가
#     제한될 수 있다. .env 가 먹지 않으면 wp-config.php 에 직접 정의하라:
#         define( 'DD_GEMINI_API_KEY', '...' );
# =============================================================

# ---- Gemini (강좌/이미지/스토리/뉴스레터 생성) --------------
# https://aistudio.google.com/apikey
DD_GEMINI_API_KEY=

# ---- YouTube Data API v3 (관련 영상 검색 및 임베드) ---------
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
DD_YOUTUBE_API_KEY=

# ---- Pixabay (강좌 썸네일 자동 가져오기) --------------------
# https://pixabay.com/api/docs/
DD_PIXABAY_API_KEY=
